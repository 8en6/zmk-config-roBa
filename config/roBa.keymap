#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// -------------------------------------------------------------------------
// JIS変換定義 (OSが日本語配列設定の場合の出力マッピング)
// -------------------------------------------------------------------------
#define JP_AT           LBKT             // @ (USの [ キー)
#define JP_CARET        EQUAL            // ^ (USの = キー)
#define JP_YEN          INT3             // ¥ (JISの ¥ キー)
#define JP_PIPE         LS(INT3)         // | (Shift + ¥)
#define JP_COLON        SQT              // : (USの ' キー)
#define JP_LBRACKET     RBKT             // [ (USの ] キー)
#define JP_RBRACKET     NUHS             // ] (USの \ キー / Non-US #)
#define JP_UNDERSCORE   LS(INT1)         // _ (Shift + Ro)
#define JP_BACKSLASH    INT1             // \ (Roキー)

// Shiftが必要な記号
#define JP_DQUOTE       LS(N2)           // "
#define JP_AMPERSAND    LS(N6)           // &
#define JP_QUOTE        LS(N7)           // '
#define JP_LPAREN       LS(N8)           // (
#define JP_RPAREN       LS(N9)           // )
#define JP_EQUAL        LS(MINUS)        // =
#define JP_PLUS         LS(SEMI)         // +
#define JP_ASTERISK     LS(SQT)          // *
#define JP_TILD         LS(EQUAL)        // ~
#define JP_GRAVE        LS(LBKT)         // `
#define JP_LBRACE       LS(RBKT)         // {
#define JP_RBRACE       LS(NUHS)         // }


&trackball {
//    automouse-layer = <4>;
    scroll-layers = <3>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <2 3>;
        };

//        muhennkann {
//            bindings = <&to_layer_0 INT_MUHENKAN>;
//            key-positions = <11 10>;
//        };

//        double_quotation {
//            bindings = <&kp DOUBLE_QUOTES>;
//            key-positions = <20 21>;
//        };

//        eq {
//            bindings = <&kp EQUAL>;
//            key-positions = <24 25>;
//        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc SCRL_UP>
                , <&macro_release &kp LCTRL>;
        };

        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc SCRL_DOWN>
                , <&macro_release &kp LCTRL>;
        };

    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // スクロール用のbehaviorの設定
        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>; // スクロールのタップ時間
        };

        // 高速タイピング用のMod-Tap設定（Home Row Mods用）
        mt_tap: mod_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";      // ★重要：他のキーと重なってもTap（文字）を優先する
            tapping-term-ms = <200>;       // 長押しの判定時間（好みで調整）
            quick-tap-ms = <150>;          // 連続タップで文字をリピートさせる
            require-prior-idle-ms = <125>; // ★超重要：直前に別のキーを打っていたら、強制的にTapにする
            bindings = <&kp>, <&kp>;
        };
        
        // KとL専用の遅いLayer-Tap
        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; // 短く押した時は確実にキー入力を優先
            tapping-term-ms = <250>;  // ★ここを好みの長さに設定（デフォルトは200）
            quick-tap-ms = <200>;     // 連続タップ時のレイヤー暴発防止
            require-prior-idle-ms = <125>; // ★これを追加：直前に別のキー入力があれば絶対にTap(文字)にする
            bindings = <&mo>, <&kp>;  // 長押しでレイヤー(&mo)、短押しでキー(&kp)
            
            display-name = "Layer Tap Slow";
        };

        // ダブルタップ＆ホールドで連続バックスペースになるLayer-Tap
        lt_bspc: layer_tap_backspace {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>; // 通常の長押し（Hold）判定時間
            quick-tap-ms = <200>;    // ★ここがダブルタップリピートの受付時間です
            bindings = <&mo>, <&kp>; // ※もしMod-Tapとして使う場合は <&kp>, <&kp> にしてください
        };

            rot_zoom: sensor_rotate_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in>, <&zoom_out>;
            tap-ms = <20>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&lt_slow 4 Q      &kp W         &kp E         &kp R       &kp T                                                          &kp Y        &kp U  &kp I             &kp O             &kp P
&mt_tap LALT A    &kp S         &kp D         &kp F       &kp G        &kp LG(L)                 &kp JP_CARET       &kp H        &kp J  &lt_slow 3 K      &lt_slow 4 L      &mt_tap LALT SEMI
&mt_tap LSHFT Z   &kp X         &kp C         &kp V       &kp B        &kp JP_LBRACKET           &kp JP_RBRACKET    &kp N        &kp M  &kp COMMA         &kp DOT           &mt_tap LSHFT SLASH
&kp LCTRL         &kp LWIN      &kp LEFT_ALT  &lt 1 INT5  &lt 4 SPACE  &lt 3 INT4                &lt_bspc 6 BSPC  &lt 2 RET                                                 &lt 5 ESC
            >;
        };

        FUNCTION {
            sensor-bindings = <&rot_zoom>;
            bindings = <
&none      &none                &kp LC(LS(UP))    &kp PG_UP           &none                              &none           &kp LS(UP)       &kp UP            &none          &kp LALT
&kp LALT   &kp LC(LS(LEFT))     &kp LC(LS(DOWN))  &kp LC(LS(RIGHT))   &kp HOME  &trans          &none    &kp HOME        &kp LEFT         &kp DOWN          &kp RIGHT      &kp LSHFT
&kp LSHFT  &kp LA(PG_UP)        &kp PG_DN         &kp LA(PG_DN)       &kp END   &kp LG(LS(C))   &none    &kp END         &kp LS(LEFT)     &kp LS(DOWN)      &kp LS(RIGHT)  &none
&kp LCTRL  &kp LWIN             &kp LALT          &trans              &trans    &trans          &trans   &kp LA(ENTER)                                                     &none
            >;
        };

        NUM {
            sensor-bindings = <&rot_zoom>;
            bindings = <
&kp N1       &kp N2      &kp N3           &kp N4       &kp N5                                  &none         &kp LS(UP)       &kp UP            &none          &kp LALT
&kp N6       &kp N7      &kp N8           &kp N9       &kp N0   &kp LG(LS(C))        &none     &kp HOME      &kp LEFT         &kp DOWN          &kp RIGHT      &kp LSHFT
&kp LS(SEMI) &kp MINUS   &kp LS(JP_COLON) &kp FSLH     &kp DOT  &kp LG(LS(C))        &none     &kp END       &kp LS(LEFT)     &kp LS(DOWN)      &kp LS(RIGHT)  &none
&kp LCTRL    &kp LWIN    &kp LALT         &kp TAB      &kp RET  &kp BSPC                       &trans        &kp LA(ENTER)                                     &none
            >;
        };

        ARROW {
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp LS(N7)    &kp LS(N2)    &kp LS(MINUS) &none           &kp LS(SEMI)                                                 &kp JP_YEN   &kp LS(0x87) &kp LS(N8)       &kp LS(N9)  &kp LS(N5)
&kp JP_AT     &kp SEMI      &kp LS(N4)    &kp JP_LBRACKET &kp JP_RBRACKET  &kp LG(LS(S))         &kp LS(JP_CARET)      &kp LS(N3)   &mkp LCLK    &kp LS(JP_COLON) &mkp RCLK   &kp LS(SEMI)
&none         &none         &kp JP_COLON  &none           &kp LS(N1)       &kp LS(JP_LBRACKET)   &kp LS(JP_RBRACKET)   &kp LS(N6)   &kp MINUS    &kp LS(COMMA)    &kp LS(DOT) &kp LS(FSLH)
&kp LCTRL     &kp LWIN      &kp LALT      &trans          &trans           &trans                &trans      &kp LC(ENTER)                                                    &trans
            >;
        };

        MOUSE {
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&none      &kp TAB        &kp LC(UP)     &kp LG(UP)     &none                                  &trans     &trans     &trans      &trans       &trans
&kp LALT   &kp LC(LEFT)   &kp LC(DOWN)   &kp LC(RIGHT)  &none    &kp LG(LC(T))      &kp LC(X)  &kp LC(C)  &mkp LCLK  &mkp RCLK   &mkp RCLK    &kp LALT
&kp LSHFT  &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &none    &kp LG(LC(T))      &kp LG(V)  &kp LC(V)  &kp LC(Z)  &kp LC(Y)   &none        &kp LSHFT
&kp LCTRL  &kp LWIN       &kp LALT       &trans         &trans   &trans             &kp DEL    &kp LS(ENTER)                                  &trans
            >;
        };

        SCROLL {
            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;            
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                          &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans          &trans          &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans          &trans          &trans        &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL       &kp LWIN      &kp LALT      &trans          &trans          &trans        &trans  &trans                          &trans
            >;
        };

        layer_6 {
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;            
            bindings = <
&kp F1     &kp F2    &kp F3       &kp F4    &kp F5                            &trans   &trans  &trans  &trans  &trans
&kp F6     &kp F7    &kp F8       &kp F9    &kp F10  &trans      &trans       &trans   &trans  &trans  &trans  &trans
&kp F11    &kp F12   &trans       &trans    &trans   &trans      &bootloader  &trans   &trans  &trans  &trans  &trans
&kp LCTRL  &kp LWIN  &kp LALT     &kp TAB   &kp RET  &kp BSPC    &trans       &trans                           &trans
            >;
        };
    };
};
